# =========================
# Production (.env) Example — /opt/roof_tattoo
# Host: 109.122.6.59
# Domain: randevu-rooftattoogallery.com
# PostgreSQL aynı sunucuda (localhost) — DATABASE_SSLMODE kullanma
# =========================

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=tattoo_user
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=tattoo_db

# Auth / Admin
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Site / domain
RANDEVU_URL=https://randevu-rooftattoogallery.com
FRONTEND_ORIGIN=https://randevu-rooftattoogallery.com
CORS_ALLOWED_ORIGINS=https://randevu-rooftattoogallery.com
BUSINESS_NAME=Roof Tattoo Gallery
BUSINESS_PHONE=
BUSINESS_ADDRESS=
WORKING_HOURS="Pazartesi - Cumartesi: 12.30 - 20.30\nPazar: 12.30 - 20.00"

# WhatsApp / Wapio (OpenAPI v1.0.0)
# api_key: https://my.wapio.com.tr/hesabim
# session_id: Admin panel → Cihaz Oluştur sonrası (veya wapio_settings.json)
BOT_PHONE_NUMBER=
WAPIO_API_URL=https://my.wapio.com.tr
WAPIO_API_KEY=
WAPIO_SESSION_ID=
WAPIO_DEVICE_NAME=Roof Tattoo
WAPIO_SEND_TIMEOUT=25
# WAPIO_WEBHOOK_URL=https://randevu-rooftattoogallery.com/api/whatsapp/webhook
# WEBHOOK_SECRET — inbound webhook'u dogrulamak icin paylasilan gizli anahtar.
# Set edildikten sonra admin panelden "webhook guncelle" calistirilmali ki
# Evolution'a kayitli URL ?wtoken=... ile yeniden kaydedilsin.
# Uretmek icin: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# WEBHOOK_COOLDOWN_SECONDS=86400
# REMINDER_HOURS_BEFORE=1
# WAPIO_DEMO_MODE=true   # sadece test: OTP her zaman 123456

# Google Calendar
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_CREDENTIALS_PATH=/opt/roof_tattoo/backend/credentials/google-calendar.json
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=Europe/Istanbul
# Takvimden yanlislikla silinen bir etkinlik icin musteriye "iptal edildi"
# WhatsApp'i gitmeden once bekleme suresi (saniye).
GCAL_CANCEL_NOTIFY_GRACE_SECONDS=600

# Sadakat puanı
LOYALTY_ENABLED=true
LOYALTY_POINTS_PER_COMPLETION=100
LOYALTY_MILESTONE_COMPLETIONS=5
LOYALTY_REDEEM_POINTS=500
LOYALTY_DISCOUNT_PERCENT=10
LOYALTY_REDEMPTION_DAYS=90

# DB pool (production) — DEĞER worker BAŞINADIR, toplam degil.
# Toplam ~ (gunicorn worker sayisi × DB_POOL_MAX_CONN); bu sunucuda
# worker = cpu_count()*2+1. PostgreSQL max_connections'i asmayin.
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=8
DB_CONNECTION_TIMEOUT=10

# Bakım hatırlatması (randevu tamamlandıktan kaç saat sonra)
AFTERCARE_REMINDER_HOURS=2

# Gunicorn / systemd
APP_HOST=0.0.0.0
APP_PORT=3000
APP_DEBUG=false

# Email (optional)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

RCLONE_REMOTE=rooftattoo
RCLONE_FOLDER=RoofTattoo_Yedekleri

# UptimeRobot — HTTP health + scheduler heartbeat
# UPTIMEROBOT_API_KEY=
# UPTIMEROBOT_HEARTBEAT_URL=
