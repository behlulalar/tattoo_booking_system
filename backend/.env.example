# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=tattoo_db

# Auth / Admin
JWT_SECRET=change-me

# WhatsApp sağlayıcısı: evolution (varsayılan) | wapio
WHATSAPP_PROVIDER=evolution

# Evolution API (https://github.com/evolution-foundation/evolution-api)
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=roof-tattoo
EVOLUTION_SEND_TIMEOUT=25
# OTP_KEYBOARD_HINT_ENABLED=true
# WHATSAPP_WEBHOOK_URL=https://example.com/api/whatsapp/webhook
# WHATSAPP_DEMO_MODE=true

# WhatsApp / Wapio (WHATSAPP_PROVIDER=wapio iken)
BOT_PHONE_NUMBER=5XXXXXXXXX
WAPIO_API_URL=https://my.wapio.com.tr
WAPIO_API_KEY=
WAPIO_SESSION_ID=
WAPIO_DEVICE_NAME=Roof Tattoo
WAPIO_SEND_TIMEOUT=25
# WAPIO_WEBHOOK_URL=https://example.com/api/whatsapp/webhook
# WEBHOOK_SECRET — inbound webhook'u dogrulamak icin paylasilan gizli anahtar.
# Set edildikten sonra admin panelden "webhook guncelle" calistirilmali ki
# Evolution'a kayitli URL ?wtoken=... ile yeniden kaydedilsin.
WEBHOOK_SECRET=

# DB pool tuning (optional) — DEĞER worker BAŞINADIR, toplam degil.
# Gercek toplam ~ (gunicorn worker sayisi × DB_POOL_MAX_CONN). Gunicorn
# varsayilani cpu_count()*2+1 worker actigindan, bu carpimin PostgreSQL
# max_connections'i asmadigindan emin olun (SHOW max_connections;).
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=8
DB_CONNECTION_TIMEOUT=10

# Aftercare WhatsApp reminder (hours after appointment marked completed)
AFTERCARE_REMINDER_HOURS=2

# Google Calendar (Phase 1: tek ortak takvim, sistem -> Google)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CREDENTIALS_PATH=backend/credentials/google-calendar.json
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=Europe/Istanbul
# Takvimden yanlislikla silinen bir etkinlik icin musteriye "iptal edildi"
# WhatsApp'i gitmeden once bekleme suresi (saniye). Bu sure icinde admin
# panelden randevu 'confirmed'e geri alinirsa mesaj hic gitmez.
GCAL_CANCEL_NOTIFY_GRACE_SECONDS=600

# Sadakat puanı (tamamlanan randevuda kazanma)
LOYALTY_ENABLED=true
LOYALTY_POINTS_PER_COMPLETION=100
LOYALTY_MILESTONE_COMPLETIONS=5
LOYALTY_REDEEM_POINTS=500
LOYALTY_DISCOUNT_PERCENT=10
LOYALTY_REDEMPTION_DAYS=90

# Site / business
RANDEVU_URL=http://localhost
FRONTEND_ORIGIN=http://localhost
# Virgülle ayır; lokal için örnek: http://127.0.0.1:8000,http://localhost:8000
CORS_ALLOWED_ORIGINS=
BUSINESS_NAME=
BUSINESS_PHONE=
BUSINESS_ADDRESS=
WORKING_HOURS=

# Standalone app run (only if running python app.py directly)
APP_HOST=0.0.0.0
APP_PORT=3000
APP_DEBUG=false

# UptimeRobot (https://uptimerobot.com) — kopan servisler için HTTP/heartbeat
# Anahtar: dashboard → My Settings → API Settings
# Heartbeat URL: Add Monitor → Heartbeat
# UPTIMEROBOT_API_KEY=
# UPTIMEROBOT_HEARTBEAT_URL=

# Email notifications (optional)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

# Backup / rclone (optional)
RCLONE_REMOTE=rooftattoo
RCLONE_FOLDER=RoofTattoo_Yedekleri

# Optional: copy DB to server script
SERVER_DATABASE_HOST=
SERVER_DATABASE_PORT=5432
SERVER_DATABASE_NAME=
SERVER_DATABASE_USER=
SERVER_DATABASE_PASSWORD=

