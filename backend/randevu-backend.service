# LEGACY — production'da bu unit'i kurma.
# Kurulu servis: roof-tattoo-backend
# Kaynak: backend/tattoo-randevu-backend.service.example

[Unit]
Description=Roof Tattoo Gallery Backend (Gunicorn) — legacy port bind, kullanma
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=root
Group=root

# WorkingDirectory: Projenin tam yolu
WorkingDirectory=/opt/roof_tattoo/backend

# Environment: Virtual environment path
Environment="PATH=/opt/roof_tattoo/venv/bin"
Environment="PYTHONPATH=/opt/roof_tattoo/backend"

# ExecStart: Gunicorn komutu
# --preload: App'i önce yükle (verification_codes memory paylaşımı için gerekli)
# Her worker'ın kendi DB pool'u olacak (pool başlatması app yüklendikten sonra)
ExecStart=/opt/roof_tattoo/venv/bin/gunicorn \
    -w 4 \
    --threads 2 \
    --bind 0.0.0.0:3000 \
    --timeout 120 \
    --max-requests 1000 \
    --max-requests-jitter 50 \
    --preload \
    --access-logfile /opt/roof_tattoo/backend/gunicorn_access.log \
    --error-logfile /opt/roof_tattoo/backend/gunicorn_error.log \
    --log-level info \
    --pid /opt/roof_tattoo/backend/gunicorn.pid \
    app:app

# Graceful reload
ExecReload=/bin/kill -s HUP $MAINPID

# Restart policy
Restart=always
RestartSec=10

# Timeout
TimeoutStopSec=30

# Security (root kullanıcısı için NoNewPrivileges ve PrivateTmp kaldırıldı)
# NoNewPrivileges=true
# PrivateTmp=true

[Install]
WantedBy=multi-user.target
